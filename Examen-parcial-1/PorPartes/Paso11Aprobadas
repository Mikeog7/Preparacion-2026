import java.util.Scanner;

/**
 * PASO 11: Materias aprobadas
 *
 * SIRVE PARA: contar cuántas notas llegan al aprobado.
 * USA:        contador (aprobadas): declarado FUERA del for, "++" dentro del if,
 *             impreso DESPUÉS. Nunca se modifica la variable del for.
 * PRUEBA:     notas 6, 3.5, 8 -> 2 aprobadas.  Límite: nota 5.0 cuenta como aprobada.
 */
public class Paso11Aprobadas {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        final int APROBADO = 5;

        System.out.println("En cuantas asignaturas estas matriculado (1-10): ");
        int matriculas = scanner.nextInt();

        int aprobadas = 0;

        for (int asignatura = 1; asignatura <= matriculas; asignatura++) {
            System.out.println("Nota de la asignatura " + asignatura + ": ");
            double notaAsignatura = scanner.nextDouble();
            if (notaAsignatura >= APROBADO) {
                aprobadas++;
            }
        }

        System.out.println("Asignaturas aprobadas: " + aprobadas);

        scanner.close();
    }
}